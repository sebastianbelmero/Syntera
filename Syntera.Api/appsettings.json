{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=Syntera;User Id=sa;Password=Passwordkuat!123;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },

  "Jwt": {
    "Issuer": "Syntera.Api",
    "Audience": "Syntera.Web",
    "AccessMinutes": 15,
    "RefreshDays": 7,
    "SigningKey": "REPLACE_VIA_USER_SECRETS_OR_ENV_VAR_AT_LEAST_32_CHARS_LONG"
  },

  "Cors": {
    "Origins": [ "http://localhost:5173", "http://localhost:4173" ]
  },

  "Seed": {
    "AdminEmail": "admin@syntera.local",
    "AdminPassword": "ChangeMe!Strong#1"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/syntera-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
