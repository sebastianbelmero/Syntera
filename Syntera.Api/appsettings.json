{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Platform": "Server=localhost,1433;Database=syntera_master;User Id=sa;Password=__SET_VIA_ENV_OR_USER_SECRETS__;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },

  "Jwt": {
    "SigningKey": "__SET_VIA_ENV_VAR_SYNTERA_JWT__SIGNINGKEY_MIN_32_CHARS__",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 1
  },

  "Cors": {
    "AllowedOrigins": [],
    "DevOrigins": [ "http://localhost:5173", "http://localhost:4173" ]
  },

  "DataProtection": {
    "KeyPath": "/var/lib/syntera/keys"
  },

  "Seed": {
    "PlatformAdminEmail": "admin@syntera.com",
    "PlatformAdminPassword": "__SET_VIA_ENV_VAR_SYNTERA_SEED__PLATFORMADMINPASSWORD__"
  },

  "Audit": {
    "RetentionYears": 10
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/syntera-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
