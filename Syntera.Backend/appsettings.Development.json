{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  // COMPLIANCE (Sprint 2.5 debug): override Serilog MinimumLevel to Debug
  // so the AuthController cookie debug logs (SetRefreshCookie,
  // ReadRefreshToken) are visible during the silent-refresh-on-reload
  // investigation. Production keeps Information level — these debug
  // messages would be too noisy in prod.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },

  "ConnectionStrings": {
    "Platform": "Data Source=localhost;Database=syntera_master;Integrated Security=True;Persist Security Info=False;Pooling=False;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True",
    "Sites": {
      "kalventis": "Data Source=localhost;Database=syntera_kalventis;Integrated Security=True;Persist Security Info=False;Pooling=False;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True",
      "kalbe": "Data Source=localhost;Database=syntera_kalbe;Integrated Security=True;Persist Security Info=False;Pooling=False;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True",
      "fima": "Data Source=localhost;Database=syntera_fima;Integrated Security=True;Persist Security Info=False;Pooling=False;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True",
      "gof": "Data Source=localhost;Database=syntera_gof;Integrated Security=True;Persist Security Info=False;Pooling=False;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True",
      "dankos": "Data Source=localhost;Database=syntera_dankos;Integrated Security=True;Persist Security Info=False;Pooling=False;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True",
      "hexpharm": "Data Source=localhost;Database=syntera_hexpharm;Integrated Security=True;Persist Security Info=False;Pooling=False;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
    }
  },

  "Jwt": {
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7,
    "RefreshTokenDaysPlatform": 1,
    "RefreshTokenDaysSite": 7,
    "SigningKey": "DEV_ONLY_DO_NOT_USE_IN_PRODUCTION_32_CHARS_MIN_2026"
  },

  "Cors": {
    "AllowedOrigins": [],
    "DevOrigins": [ "http://localhost:5173", "http://localhost:4173" ]
  },

  "DataProtection": {
    // COMPLIANCE (Sprint 2.3): dev-friendly path for the DPAPI key ring so
    // TOTP secrets stay decryptable across `dotnet run` restarts. The
    // base appsettings.json points at /var/lib/syntera/keys (Production),
    // which is not writable in the dev sandbox — Program.cs falls back
    // to a local "keys" folder under the app base directory if creation
    // fails, so this explicit override is mostly belt-and-suspenders.
    "KeyPath": "./keys"
  },

  // COMPLIANCE (Sprint 2.6): disable connection-string encryption in dev
  // so the seeder can run without a writable DPAPI key ring and so the
  // Sites table stays inspectable via raw SQL during debugging. The
  // base appsettings.json enables it (default for Production). Flip to
  // true to exercise the encryption path locally.
  "ConnectionProtection": {
    "Enabled": false
  },

  // SECURITY (H7 — cookie-only refresh transport): disabled in dev so
  // Swagger, the .http debug file, and integration harnesses can exercise
  // the refresh flow by sending the token in the JSON body (a browser
  // cannot read the httpOnly cookie, so non-browser tooling has no other
  // way to hold the token across requests). The Vite dev proxy round-trips
  // the cookie correctly (Sprint 2.5 fix: cookie Domain defaults to the
  // Host header), so the frontend itself stays cookie-only even in dev.
  // Production keeps the base appsettings.json default (true = strict).
  "Auth": {
    "CookieOnlyRefreshToken": false
  },

  "Mfa": {
    // Issuer label rendered in the user's authenticator app (and in the
    // otpauth:// URL embedded in the QR code).
    "Issuer": "Syntera IAM (Dev)"
  },

  // COMPLIANCE (Sprint 2.4): password max-age enforcement. Set to 0 to
  // disable in dev (avoids forcing password rotation on every dev session
  // reboot). Production should set this to 90 (days) per 21 CFR Part 11
  // §11.300(c). 0 = disabled, >0 = max age in days.
  "PasswordPolicy": {
    "MinLength": 12,
    "MaxLength": 256,
    "RequireUpper": true,
    "RequireLower": true,
    "RequireDigit": true,
    "RequireSymbol": true,
    "MaxAgeDays": 0
  },

  "Seed": {
    "PlatformAdminEmail": "admin@syntera.com",
    "PlatformAdminPassword": "ChangeMe!Strong#1"
  },

  "Audit": {
    "RetentionYears": 1,
    "EnforceRetention": true
  },

  "Ldap": {
    "SkipCertValidation": true,
    "AllowPlainPort389": true
  }
}

