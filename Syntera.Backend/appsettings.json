  "Jwt": {
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 1,
    "RefreshTokenDaysPlatform": 1,
    "RefreshTokenDaysSite": 7
  },
  "Cors": {
    "AllowedOrigins": [],
    "DevOrigins": [
      "http://localhost:5173",
      "http://localhost:4173"
    ]
  },
  "DataProtection": {
    "KeyPath": "/var/lib/syntera/keys"
  },
  // COMPLIANCE (Sprint 2.6): opt-in for encrypting Site.DatabaseConnectionString
  // at rest via ASP.NET Core Data Protection. Default true for Production —
  // closes ISO 27001 A.8.24 and 21 CFR Part 11 §11.10(c) gaps. When true,
  // the DbSeeder encrypts new writes and auto-migrates existing plaintext
  // rows (idempotent). When false, the protector is a no-op (dev-friendly).
  // The DPAPI key ring at DataProtection:KeyPath MUST be backed up — losing
  // it makes every encrypted connection string undecryptable.
  "ConnectionProtection": {
    "Enabled": true
  },
  "Seed": {
    "PlatformAdminEmail": "admin@syntera.com",
    "PlatformAdminPassword": ""
  },
  "Audit": {
    "RetentionYears": 10,
    "EnforceRetention": false
  },
  "PasswordPolicy": {
    "MinLength": 12,
    "MaxLength": 256,
    "RequireUpper": true,
    "RequireLower": true,
    "RequireDigit": true,
    "RequireSymbol": true,
    "HistorySize": 10,
    "MaxAgeDays": 90
  },
  "Session": {
    "IdleMinutes": 30,
    "MaxHours": 8
  },
  "Mfa": {
    "Issuer": "Syntera IAM"
  },
  "TwoPerson": {
    "Enabled": false,
    "ApplyToPublish": true
  },
  "Ldap": {
    "SkipCertValidation": false,
    "AllowPlainPort389": false
  },
