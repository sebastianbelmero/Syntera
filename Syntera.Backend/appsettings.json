    "Platform": "Server=localhost;Database=syntera_master;Integrated Security=True;Persist Security Info=False;Network Library=dbmssocn;Pooling=False;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Connect Timeout=30",
    "Sites": {
      "kalventis": "Server=localhost;Database=syntera_kalventis;Integrated Security=True;Persist Security Info=False;Network Library=dbmssocn;Pooling=False;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Connect Timeout=30",
      "kalbe": "Server=localhost;Database=syntera_kalbe;Integrated Security=True;Persist Security Info=False;Network Library=dbmssocn;Pooling=False;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Connect Timeout=30",
      "fima": "Server=localhost;Database=syntera_fima;Integrated Security=True;Persist Security Info=False;Network Library=dbmssocn;Pooling=False;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Connect Timeout=30",
      "gof": "Server=localhost;Database=syntera_gof;Integrated Security=True;Persist Security Info=False;Network Library=dbmssocn;Pooling=False;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Connect Timeout=30",
      "dankos": "Server=localhost;Database=syntera_dankos;Integrated Security=True;Persist Security Info=False;Network Library=dbmssocn;Pooling=False;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Connect Timeout=30",
      "hexpharm": "Server=localhost;Database=syntera_hexpharm;Integrated Security=True;Persist Security Info=False;Network Library=dbmssocn;Pooling=False;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Connect Timeout=30"
    }
