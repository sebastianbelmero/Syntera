<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Syntera.DbSetup</RootNamespace>
    <AssemblyName>Syntera.DbSetup</AssemblyName>
    <!-- Suppress analyzer warnings from referenced project to keep output clean. -->
    <NoWarn>$(NoWarn);CA1051;CA1303;CA1848;CA1861</NoWarn>
  </PropertyGroup>

  <!-- Reference the Backend project so we can reuse PlatformDbContext, SiteDbContext,
       DbSeeder, entities, and migrations without duplicating code.
       (Previously referenced Syntera.Api — deleted in commit e675819 during the
       Backend migration; this ProjectReference was missed in that cleanup.) -->
  <ItemGroup>
    <ProjectReference Include="..\Syntera.Backend\Syntera.Backend.csproj" />
  </ItemGroup>

  <!-- COMPLIANCE (Sprint 2.6): explicit DI + DataProtection packages for
       the minimal DI container set up in Program.cs to resolve
       IConnectionStringProtector. Backend's web SDK provides these transitively,
       but adding them explicitly here avoids potential resolution issues.
       Versions MUST match the Backend's transitive versions (10.0.11) to
       avoid NU1605 downgrade errors — Backend pulls 10.0.11 via EF Core. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.11" />
  </ItemGroup>

  <!-- Copy appsettings.json from the Backend project so the setup tool reads the
       same configuration as the Backend when run. -->
  <ItemGroup>
    <None Include="..\Syntera.Backend\appsettings.json" Link="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Syntera.Backend\appsettings.Development.json" Link="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
