<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Syntera.DbSetup</RootNamespace>
    <AssemblyName>Syntera.DbSetup</AssemblyName>
    <!-- Suppress analyzer warnings from referenced project to keep output clean. -->
    <NoWarn>$(NoWarn);CA1051;CA1303;CA1848;CA1861</NoWarn>
  </PropertyGroup>

  <!-- Reference the Backend project so we can reuse PlatformDbContext, SiteDbContext,
       DbSeeder, entities, and migrations without duplicating code.
       (Previously referenced Syntera.Api — deleted in commit e675819 during the
       Backend migration; this ProjectReference was missed in that cleanup.) -->
  <ItemGroup>
    <ProjectReference Include="..\Syntera.Backend\Syntera.Backend.csproj" />
  </ItemGroup>

  <!-- Copy appsettings.json from the Backend project so the setup tool reads the
       same configuration as the Backend when run. -->
  <ItemGroup>
    <None Include="..\Syntera.Backend\appsettings.json" Link="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Syntera.Backend\appsettings.Development.json" Link="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
