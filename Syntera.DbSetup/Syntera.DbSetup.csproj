<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Syntera.DbSetup</RootNamespace>
    <AssemblyName>Syntera.DbSetup</AssemblyName>
    <!-- Suppress analyzer warnings from referenced project to keep output clean. -->
    <NoWarn>$(NoWarn);CA1051;CA1303;CA1848;CA1861</NoWarn>
  </PropertyGroup>

  <!-- Reference the API project so we can reuse PlatformDbContext, SiteDbContext,
       DbSeeder, entities, and migrations without duplicating code. -->
  <ItemGroup>
    <ProjectReference Include="..\Syntera.Api\Syntera.Api.csproj" />
  </ItemGroup>

  <!-- Copy appsettings.json from the API project so the setup tool reads the
       same configuration as the API when run. -->
  <ItemGroup>
    <None Include="..\Syntera.Api\appsettings.json" Link="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Syntera.Api\appsettings.Development.json" Link="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
