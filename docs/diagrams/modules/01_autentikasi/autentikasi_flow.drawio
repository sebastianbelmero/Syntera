        <mxCell id="a7" value="7. Sesi berjalan: idle 15 menit → warning 60 dtk → perpanjang / logout (FS-AUTH-06)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
