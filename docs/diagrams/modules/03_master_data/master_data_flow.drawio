        <mxCell id="m4" value="4. Effective date ditetapkan → status effective → notifikasi stakeholder terdampak" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
