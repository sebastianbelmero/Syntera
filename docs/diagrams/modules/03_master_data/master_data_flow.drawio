        <mxCell id="m1" value="1. SME / Metrology Lead buat draft entri master (field wajib + keunikan sop_no/code/serial)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
