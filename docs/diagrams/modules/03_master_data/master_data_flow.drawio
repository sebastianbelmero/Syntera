        <mxCell id="m5" value="5. Entri dikonsumsi modul RA / WO / CAL — dibekukan ke snapshot WO saat assignment (immutable)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
