        <mxCell id="m6" value="6. Revisi → versi BARU menempuh alur dari awal; WO in-progress tetap memakai versi snapshot (snapshot lock)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1056" width="190" height="74" as="geometry" />
