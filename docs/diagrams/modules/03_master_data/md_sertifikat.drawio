          <mxGeometry x="20" y="16" width="620" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Tabel: syn_certificate (FS-MD-04) · PDF/A-2b + SHA-256 + QR /verify/{uuid}" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="20" y="48" width="620" height="24" as="geometry" />
        </mxCell>
        <mxCell id="st" value="Mulai" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F1F5F9;strokeColor=#334155;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="435" y="104" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="1. Dua jalur masuk: (a) cert internal digenerate dari WO selesai (wo_id unik) · (b) cert vendor di-upload (kalibrator / media / kalibrasi eksternal)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="194" width="190" height="104" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="2. certificate_no dialokasikan via modul DNG (penomoran terkontrol, terpisah dari WO number)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="328" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="3. certificate_uuid dibuat → dasar QR code verifikasi lapangan (/verify/{uuid})" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="432" width="190" height="59" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="4. Simpan file PDF/A-2b di object storage + hitung SHA-256 hash (integritas)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="521" width="190" height="59" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="5. Isi metadata metrologi: expiry_date, k_factor, uncertainty (input Type B uncertainty budget)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="610" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="c_d1" value="Cert final (terverifikasi)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" vertex="1" parent="1">
          <mxGeometry x="390" y="714" width="150" height="84" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="6. Cert final = immutable; koreksi = cert BARU + referensi supersede; retensi ikut kebijakan GxP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="854" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="7. Cert vendor kalibrator di-link ke syn_calibrator.certificate_id → perbarui k-factor &amp; expiry kalibrator" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="958" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="8. Cert media di-link ke syn_media.certificate_id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1062" width="190" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="9. Saat WO assignment: data cert (cert_no + expiry + K-factor + uncertainty) masuk snapshot syn_wo_calibrator / syn_wo_media — renew mid-WO tidak mengubah eksekusi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1144" width="190" height="119" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="10. QR pada label/dokumen menunjuk endpoint publik verifikasi keaslian; semua akses tercatat audit trail" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1293" width="190" height="74" as="geometry" />
