        <mxCell id="w1" value="1. Pull forecast PM 30 hari dari Oracle EAM — ORDS REST, filter activity Calibration, cache TTL 6 jam" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="194" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="2. Engineering Planner review list forecast (urut Due Date; re-trigger bila data basi)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="298" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="w3" value="3. Implement item → cek idempotensi UNIQUE (asset + activity + periode due)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="402" width="190" height="59" as="geometry" />
        </mxCell>
        <mxCell id="w_d1" value="Sudah ada WO?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" vertex="1" parent="1">
          <mxGeometry x="390" y="491" width="150" height="84" as="geometry" />
        </mxCell>
        <mxCell id="w4" value="4. CreateWO via ISG SOAP ke Oracle EBS → oracle_wo_number (transaksi DB + SOAP atomik)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="605" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="w5" value="5. Insert syn_wo_ref (DRAFT) + nomor WO dari DNG (WO number ≠ nomor sertifikat, ISO)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="709" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="w7" value="7. Batch release bulanan (maks 10 SOAP concurrent) — Unreleased → Released" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="839" width="190" height="59" as="geometry" />
        </mxCell>
        <mxCell id="w_d2" value="Activity = kalibrasi?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" vertex="1" parent="1">
          <mxGeometry x="390" y="928" width="150" height="84" as="geometry" />
        </mxCell>
        <mxCell id="w8" value="8. Distribusi Monthly PM Schedule PDF ke stakeholder (email + in-app — NOTIF/DOC)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1042" width="190" height="59" as="geometry" />
        </mxCell>
        <mxCell id="w9" value="9. Technician acknowledge WO (Released → Acknowledged)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1131" width="190" height="52" as="geometry" />
        </mxCell>
        <mxCell id="w10" value="10. Auto-assignment: competency matrix (qualified, expiry &gt; due) + least-pending-WO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1213" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="w_d3" value="Supervisor override?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" vertex="1" parent="1">
          <mxGeometry x="390" y="1317" width="150" height="84" as="geometry" />
        </mxCell>
        <mxCell id="w11" value="11. Assignment → snapshot immutable 14-entity + hash SHA-256 (FS-WO-SNAP-01)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1431" width="190" height="59" as="geometry" />
        </mxCell>
        <mxCell id="w12" value="12. Eksekusi kalibrasi (modul CAL): pre-start → readings → verdict → report" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1546" width="190" height="59" as="geometry" />
        </mxCell>
        <mxCell id="w13" value="13. Review &amp; approval 4-tier → cetak label (LBL) → Completed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1635" width="190" height="59" as="geometry" />
        </mxCell>
        <mxCell id="w14" value="14. (Kapan pun sebelum selesai) Ajukan cancel: alasan wajib + link tiket deviasi QMS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1750" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="w15" value="15. Approval paralel Supervisor + QA (e-sign, APPR) + notifikasi stakeholder" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1854" width="190" height="59" as="geometry" />
        </mxCell>
        <mxCell id="w16" value="16. Dual-write: syn_wo_ref = CANCELLED + Oracle CancelWO + update tiket QMS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
