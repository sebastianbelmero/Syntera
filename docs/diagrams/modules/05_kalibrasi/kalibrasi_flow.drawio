          <mxGeometry x="390" y="501" width="150" height="84" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="3. Pre-start check: 5S, safety/APD, scan QR ID kalibrator &amp; media — status In-Progress" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="615" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="c_d3" value="Kondisi fisik OK?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" vertex="1" parent="1">
          <mxGeometry x="390" y="719" width="150" height="84" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="4. Capture env awal (temp/RH ± tekanan) → validasi vs range SOP — syn_wo_env" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="833" width="190" height="59" as="geometry" />
        </mxCell>
        <mxCell id="c_d4" value="Env out-of-range?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" vertex="1" parent="1">
          <mxGeometry x="390" y="922" width="150" height="84" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="5. Executing — single-writer lock; autosave DRAFT 30 dtk (di luar audit trail); pause → re-auth 15 mnt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1062" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="6. LOOP per titik × siklus × stage × replicate × channel: input std &amp; uut terpisah + validasi range real-time" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#64748B;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="1166" width="190" height="89" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="7. Auto-kalkulasi correction = std − uut; evaluasi real-time vs criteria (dari snapshot)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1285" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="8. Attachment bukti: foto setup ≥ 2, foto per titik ≤ 5, video ≥ 30 dtk — SHA-256, append-only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1389" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="c_d5" value="As-found OOS &amp; SOP ada adjustment?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" vertex="1" parent="1">
          <mxGeometry x="390" y="1493" width="150" height="84" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="9. Capture env akhir + validasi ulang vs range SOP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1607" width="190" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="10. Metrology engine per titik: Type A/B → Uc (RSS) → veff (Welch-Satterthwaite) → k95 (t-dist) → U95" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1715" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="11. Verdict per titik: pass / OOS (|correction| &gt; criteria) · konsistensi max_spread ≤ U95" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1819" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="c_d6" value="Verdict WO?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" vertex="1" parent="1">
          <mxGeometry x="390" y="1923" width="150" height="84" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="12. OOS → tiket deviasi QMS otomatis (REST, link dua-arah) · OOT (alat terpakai produksi) → Risk Assessment + query batch Oracle" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="2037" width="190" height="89" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="13. Modal kesimpulan (Pass / Pass with Note / Not Pass) → acknowledge technician" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="2182" width="190" height="59" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="14. SUBMIT — semua record FINAL &amp; immutable; status Report-Submitted (tidak bisa dibatalkan)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="2271" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="15. Generate sertifikat PDF/A-2b draft (watermark DRAFT, QR code, SHA-256)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="2375" width="190" height="59" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="16. Review bertingkat: Supervisor (teknis) → Eng. Manager (judgment) → QO Manager (GMP)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="2464" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="c_d7" value="Revisi diminta?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" vertex="1" parent="1">
          <mxGeometry x="390" y="2568" width="150" height="84" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="17. Final e-sign 2-of-3: Eng. Manager + QO Manager — re-auth 5 mnt, manifest immutable" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="2682" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="18. Drift history + recal interval 4-tier (≤0.1×tol / 50% / +correction factor / REJECTED → decommission) → update next_cal_date" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="2812" width="190" height="89" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="19. Cetak label ZPL + foto label (modul LBL) → status Labeled" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="2931" width="190" height="59" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="20. Closure oleh Planner: gate approval + deviation/CAPA closed → Oracle WMA-PWO-A-12 → CLOSED immutable" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="3020" width="190" height="74" as="geometry" />
