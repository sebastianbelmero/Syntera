        <mxCell id="c1" value="1. Buka detail WO — konteks 14-entity snapshot (aset, SOP, kalibrator, media, kompetensi) read-only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
