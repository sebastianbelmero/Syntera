        </mxCell>
        <mxCell id="c2" value="2. Validasi expiry: sertifikat kalibrator, media, kompetensi technician" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="412" width="190" height="59" as="geometry" />
        </mxCell>
