        <mxCell id="r1" value="1. SysAdmin / Metrology Lead definisikan report template (kode, format PDF/Excel/CSV, parameter schema, requires_approval)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
