        </mxCell>
        <mxCell id="a4" value="4. Buat approval instance (pin versi template) + baris syn_approval_step per slot approver (pending, sla_due_at)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="536" width="190" height="89" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="5. NOTIF → approver: pending request + payload review (preview label / hasil kalibrasi / verdict)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="655" width="190" height="74" as="geometry" />
        </mxCell>
