        </mxCell>
        <mxCell id="a6" value="6. Approve → ESIGN re-auth + manifest (tier, signer, role, meaning, hash, IP, UTC) → step approved" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
