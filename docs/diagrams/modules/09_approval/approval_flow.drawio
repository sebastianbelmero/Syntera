        </mxCell>
        <mxCell id="a3" value="3. Resolve approver via approval matrix per site; cek delegasi aktif (on_behalf_of_user_id)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
