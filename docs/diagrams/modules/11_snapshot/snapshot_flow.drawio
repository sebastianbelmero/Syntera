        </mxCell>
        <mxCell id="n1" value="1. Baca nilai terkini 14 entitas: asset, kalibrator+cert, media, SOP+config, WO, PM schedule, user+kompetensi, device, ambient range, foto, approval chain, titik template" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="194" width="190" height="119" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="2. Tulis snapshot family INSERT-only (DB trigger): syn_wo_snapshot, syn_wo_calibrator, syn_wo_media, syn_wo_cal_point, syn_wo_env, syn_wo_approval" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="343" width="190" height="104" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="3. Hash chain per baris: hash = SHA256(record_data ‖ hash_prev)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="477" width="190" height="59" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="4. Snapshot immutable — tak dapat diedit/dihapus siapa pun, termasuk System Administrator" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="566" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="5. Teknisi eksekusi: setiap reading (syn_wo_result) me-reference cal_point_id DARI SNAPSHOT — bukan master live" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
