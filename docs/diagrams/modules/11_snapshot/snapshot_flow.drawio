        <mxCell id="n6" value="6. Verdict dihitung vs criteria_snapshot (JSONB) → hasil FINAL immutable → alur approval (APPR/ESIGN)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="929" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="7. Auditor: Hash Chain Integrity Verification — seluruh log / per WO / per tanggal / per site" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1059" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="8. Sistem hitung ulang hash tiap snapshot &amp; bandingkan dengan rantai (hash_prev linkage)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
