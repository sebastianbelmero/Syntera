        <mxCell id="n9" value="9. Hasil → syn_snapshot_verification + laporan PDF ber-digital-signature Syntera (verifikasi bulanan — FDA best practice)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
