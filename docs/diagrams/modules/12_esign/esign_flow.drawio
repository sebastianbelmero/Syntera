        <mxCell id="sub" value="Sumber: FSD 2.8 (ESIGN) · 21 CFR Part 11 §11.50 manifest + §11.200 two-component" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="20" y="48" width="620" height="24" as="geometry" />
        </mxCell>
        <mxCell id="st" value="Mulai&lt;br&gt;(modul minta sign)" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F1F5F9;strokeColor=#334155;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="435" y="104" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="1. Modul pemanggil → ESIGN API POST /esign/sign (record_id, record_hash, authority_level, reason)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="194" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="e_d1" value="Sign-token valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" vertex="1" parent="1">
          <mxGeometry x="390" y="298" width="150" height="84" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="2. Re-auth: password ulang (AD) + OTP 6-digit (10 mnt, one-time) — signing PERTAMA sesi wajib 2 komponen; token 60 dtk one-time" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="412" width="190" height="89" as="geometry" />
        </mxCell>
        <mxCell id="e_d2" value="Komponen lolos?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" vertex="1" parent="1">
          <mxGeometry x="390" y="531" width="150" height="84" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="3. Hitung record_hash sebelum &amp; sesudah signing → binding kriptografis signature ke record" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="645" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="4. Tulis manifest INSERT-only: printed name, UTC, meaning (REVIEW/APPROVE/AUTHOR/REJECT), reason, hash before/after, on_behalf_of, IP, session" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="775" width="190" height="104" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="5. signature_hash = SHA256(record_hash ‖ user_id ‖ timestamp ‖ authority_level)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="909" width="190" height="59" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="6. Konfirmasi eksplisit ke user: menerapkan e-signature + alasan (FS-ESIGN-09)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="998" width="190" height="59" as="geometry" />
        </mxCell>
        <mxCell id="e_d3" value="Authority level?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" vertex="1" parent="1">
          <mxGeometry x="390" y="1087" width="150" height="84" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="7. Level 2: record/channel di-LOCK (syn_record_signoff_lock) — unlock hanya via formal change control → paksa re-sign" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1201" width="190" height="89" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="8. Manifest immutable masuk hash chain AUDIT + ditampilkan di SETIAP halaman PDF record" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1320" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="e_d4" value="Record berubah pasca-sign (delta-hash)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" vertex="1" parent="1">
          <mxGeometry x="390" y="1424" width="150" height="84" as="geometry" />
        </mxCell>
