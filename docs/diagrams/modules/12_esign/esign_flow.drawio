          <mxGeometry x="435" y="1538" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fail" value="Attempt gagal → syn_signature_attempt_log (BAD_PASSWORD / BAD_OTP / TOKEN_EXPIRED / RECORD_HASH_MISMATCH); N kali → sesi ditolak — tanpa bypass, prosedur kompromi token/device" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;dashed=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontStyle=2;fontColor=#475569;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
