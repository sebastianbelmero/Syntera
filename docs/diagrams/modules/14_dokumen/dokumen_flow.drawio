          <mxGeometry x="20" y="16" width="620" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Sumber: FSD 2.11 (DOC) · versioning + retensi GxP + QR verifikasi + cold storage" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="20" y="48" width="620" height="24" as="geometry" />
        </mxCell>
        <mxCell id="st" value="Mulai" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F1F5F9;strokeColor=#334155;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="435" y="104" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o1" value="1. Trigger: WO complete → auto-generate Certificate PDF (titik, readings, U95, env, e-sign, QR) ATAU user upload (vendor cert / SOP / lampiran)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="194" width="190" height="104" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="2. Request nomor dokumen ke modul DNG → document_number unik" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="328" width="190" height="59" as="geometry" />
        </mxCell>
        <mxCell id="o3" value="3. Simpan binary ke object storage (storage_key) + record syn_document" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="417" width="190" height="59" as="geometry" />
        </mxCell>
        <mxCell id="o4" value="4. Auto-extract metadata (Tika: PDF/XLSX/DOCX); dokumen scan → OCR → ocr_text utk full-text search" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="506" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="o5" value="5. Index metadata + teks ke search engine → dokumen dapat dicari (filter + full-text)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="610" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="o6" value="6. Buat versi awal syn_document_version (major.minor, checksum SHA-256); revisi SOP → versi baru, versi lama tetap accessible" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="714" width="190" height="89" as="geometry" />
        </mxCell>
        <mxCell id="o7" value="7. Check-out (kunci eksklusif) → edit → check-in sebagai versi baru; file versi lama immutable (checksum)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="859" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="o8" value="8. Review &amp; approval workflow dokumen: reviewer memeriksa via preview in-app (watermark, tanpa download)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="963" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="o_d1" value="Disetujui?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" vertex="1" parent="1">
          <mxGeometry x="390" y="1067" width="150" height="84" as="geometry" />
        </mxCell>
        <mxCell id="o9" value="9. Tetapkan effective_date → versi ACTIVE; versi sebelumnya otomatis superseded" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1181" width="190" height="59" as="geometry" />
        </mxCell>
        <mxCell id="o10" value="10. QR code verify/{certificate_uuid} di PDF + manifest tanda tangan tampil di setiap halaman" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1270" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="o11" value="11. Retensi berjalan: GxP ≥ 10 tahun / non-GxP 5 tahun; alert H-90 sebelum habis" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1400" width="190" height="59" as="geometry" />
        </mxCell>
        <mxCell id="o12" value="12. WO Closed + retensi tercapai → pindah cold storage (Glacier, tier COLD) — tetap accessible utk audit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1489" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="o13" value="13. Retensi habis → permintaan disposal (reason wajib) → QA approval → disposed + audit log lengkap" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1593" width="190" height="74" as="geometry" />
        </mxCell>
