        <mxCell id="ph_15_dng_flow_4434" value="Fase 1 — Generate nomor (atomic)" style="rounded=1;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#475569;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="338" y="74" width="254" height="1229" as="geometry" />
        </mxCell>
        <mxCell id="ttl" value="Modul Generator Nomor Dokumen — Diagram Alur Detail" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="20" y="16" width="620" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Sumber: FSD 2.12 (DNG) · sequence atomik: no duplicate, no gap · reset per bulan/tahun/site" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="20" y="48" width="620" height="24" as="geometry" />
        </mxCell>
        <mxCell id="st" value="Mulai&lt;br&gt;(modul minta nomor)" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F1F5F9;strokeColor=#334155;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="435" y="104" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="1. Modul pemanggil (RA/WO/CAL/DOC/DEV) panggil API DNG: doc_type, site, requester user &amp; module" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="194" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="2. Baca konfigurasi format aktif: syn_doc_number_format (template, reset_period, padding)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="298" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="3. Hitung period_key sesuai reset (bulanan '2026-09' / tahunan / +site utk isolasi multi-site)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="402" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="g_d1" value="Periode baru?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" vertex="1" parent="1">
          <mxGeometry x="390" y="506" width="150" height="84" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="4. Buat baris sequence baru last_sequence = 0 — reset otomatis saat period_key berganti" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="620" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="g5" value="5. Lock baris syn_doc_sequence (SQL Server: UPDLOCK/HOLDLOCK) → thread-safe, concurrent tak bisa baca nilai sama" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="724" width="190" height="89" as="geometry" />
        </mxCell>
        <mxCell id="g6" value="6. Increment last_sequence → sequence_value (padding 4-5 digit)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="843" width="190" height="59" as="geometry" />
        </mxCell>
        <mxCell id="g7" value="7. Format resolver: substitusi {sequence} {site_initial} {doc_type} {roman_month} {year} → nomor final" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="932" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="g8" value="8. Tulis log immutable syn_doc_number_log (nomor, tipe, modul &amp; user peminta, UTC)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1036" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="g9" value="9. Commit (lock dilepas) → nomor dikembalikan ke modul pemanggil" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1140" width="190" height="59" as="geometry" />
        </mxCell>
        <mxCell id="en" value="Selesai" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F1F5F9;strokeColor=#334155;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="435" y="1229" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="wo" value="Nomor WO ≠ nomor Certificate (ISO, FS-DNG-WOCERT-01): &lt;SITE&gt;-WO-YYYYMM-NNNNN vs &lt;SITE&gt;-CAL-YYYYMM-NNNNN — sequence terpisah, reset per site per bulan" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;dashed=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontStyle=2;fontColor=#475569;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
