        </mxCell>
        <mxCell id="o1" value="1. Admin: konfigurasi per site — URL ORDS/ISG, kredensial terenkripsi (Vault), sync_rules (field mapping), retry policy, instance backup" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="194" width="190" height="104" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="2. Scheduler: sync asset download (event-driven + batch reconciliation hourly/daily) + query PM forecast 30 hari (ORDS REST, Calibration)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="328" width="190" height="104" as="geometry" />
        </mxCell>
        <mxCell id="o3" value="3. Mapping/transform field per sync_rules; deteksi Activity Type 'Calibration External' → auto-flag WO external" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="462" width="190" height="89" as="geometry" />
