          <mxGeometry x="390" y="581" width="150" height="84" as="geometry" />
        </mxCell>
        <mxCell id="o4" value="4. Upsert syn_asset / syn_forecast_cache + tulis sync log (UTC, op_type, status)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="695" width="190" height="59" as="geometry" />
        </mxCell>
        <mxCell id="o5" value="5. Rilis/status WO dua arah real-time via ISG SOAP: Unreleased → Released → Complete → Closed / Cancelled" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="810" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="o6" value="6. PR vendor re-calibration via API WMA-UWO-A-10 → pr_number disimpan di syn_wo_ref" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="914" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="o7" value="7. Upload certificate PDF ke Oracle sebagai WO attachment (pasca approval, op CERT_UPLOAD)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1018" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="o8" value="8. Gagal → retry in-line 3x (exponential backoff) → DLQ backoff 1m/5m/30m/2h/12h/24h → failover backup bila primary down &gt;24 jam → EXHAUSTED (manual)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1148" width="190" height="104" as="geometry" />
        </mxCell>
