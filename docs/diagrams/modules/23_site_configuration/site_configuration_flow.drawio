        <mxCell id="s1" value="1. Buat Site Master Record: code, name, address, initials, timezone, currency, locale (FS-SITE-01/02)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="194" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2. Provisioning DB site baru (schema identik syntera_[site]) + connection string terenkripsi (ENC:) + clone role template published + seed permission" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
