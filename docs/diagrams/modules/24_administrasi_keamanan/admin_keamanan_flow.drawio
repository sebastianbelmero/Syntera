        <mxCell id="ph_24_as_flow_3096" value="Fase 1 — Akses &amp; autentikasi keamanan (FS-AS-01..05)" style="rounded=1;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#475569;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
