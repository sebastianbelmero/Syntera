        <mxCell id="st" value="Mulai" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F1F5F9;strokeColor=#334155;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="435" y="104" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="1. Admin Business buat definisi: entity (ASSET/WO/SOP/CALIBRATOR/DEVIATION), field_key, label ID/EN, tipe data (10), mandatory/unique/searchable, regex/min/max, default" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="194" width="190" height="119" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="2. Dropdown / multi-select → konfigurasi opsi (value unik, label bilingual, urutan, aktif)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="343" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="3. Izin per role: can_view / can_edit per definisi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="447" width="190" height="52" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="4. Draft → pending_qo_approval → QO Manager approve → active (versioning: entity + field_key + versi unik)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="529" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="5. Render field di form sesuai definisi active + izin role (tanpa can_view → tidak tampil; mandatory → wajib)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="659" width="190" height="89" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="6. User isi nilai → validasi server-side: regex, min/max, opsi aktif, unique, blank required (NF-ER-04)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="778" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="f7" value="7. Simpan nilai typed-columns per record entity (value_text/number/date/boolean/json/ref/file)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="882" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="f8" value="8. Tampil di form, list, pencarian (searchable), laporan, dan label yang mereferensikannya" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="986" width="190" height="74" as="geometry" />
        </mxCell>
        <mxCell id="f9" value="9. Record entity mencapai approved → SEMUA nilai custom field DIKUNCI (server-side enforcement — bukan sekadar UI hidden)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1116" width="190" height="89" as="geometry" />
        </mxCell>
        <mxCell id="f10" value="10. Write ke record approved → DITOLAK 'field locked' · override hanya via change request + e-sign QO + alasan (before/after audit)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1235" width="190" height="89" as="geometry" />
        </mxCell>
        <mxCell id="f11" value="11. Definisi tak dipakai → retired; nilai historis dibaca sesuai definisi versi saat nilai dibuat (interpretasi konsisten)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="370" y="1354" width="190" height="89" as="geometry" />
